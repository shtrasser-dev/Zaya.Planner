{
  "entity": {
    "calendar": {
      "plans": {
        "default": "mdi:calendar-clock"
      }
    },
    "sensor": {
      "next_step": {
        "default": "mdi:clock-outline"
      },
      "failed_plans": {
        "default": "mdi:alert-circle-outline"
      },
      "plans": {
        "default": "mdi:format-list-checks"
      },
      "event_errors": {
        "default": "mdi:calendar-alert"
      }
    }
  },
  "services": {
    "add_step": {
      "service": "mdi:playlist-plus"
    },
    "set_plan": {
      "service": "mdi:calendar-check"
    },
    "cancel_plan": {
      "service": "mdi:calendar-remove"
    },
    "get_plans": {
      "service": "mdi:format-list-bulleted"
    },
    "ensure_state": {
      "service": "mdi:toggle-switch-outline"
    },
    "find_events": {
      "service": "mdi:calendar-filter"
    },
    "plan_window": {
      "service": "mdi:clock-time-four-outline"
    },
    "plan_marks": {
      "service": "mdi:map-marker-star"
    },
    "freeze_plans": {
      "service": "mdi:snowflake"
    },
    "unfreeze_plans": {
      "service": "mdi:snowflake-off"
    }
  }
}
